# Copy to .env and fill in ONE provider. Everything else is optional.

# Which LLM to use: groq | openai | anthropic | ollama   (all free-tier / local)
LLM_PROVIDER=groq
# Optional model override (defaults: groq=openai/gpt-oss-120b, openai=gpt-4o-mini,
# anthropic=claude-sonnet-5, ollama=llama3.1)
# LLM_MODEL=

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama: use http://host.docker.internal:11434 when the backend runs in Docker
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional tuning ---------------------------------------------------------
# RAG_TOP_K=3
# MAX_HISTORY_MESSAGES=20
# MAX_AGENT_STEPS=8
# LOG_LEVEL=INFO

# --- Optional observability (LangSmith) ---------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=omnicare-assistant
